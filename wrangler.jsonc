{
  "name": "jolee-remote",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "Session", "class_name": "Session" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Session"] }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "MINT_SECRET": "",
    // Default initial session duration: one hour (seconds).
    "SESSION_TTL_SECONDS": "3600"
  }
}
